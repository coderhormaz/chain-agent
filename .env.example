# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Encryption key for wallet private keys (generate a secure key in production)
VITE_ENCRYPTION_KEY=your-secure-encryption-key-here

# Google Gemini AI Configuration
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Smart Contract Addresses (opBNB Mainnet) - UPDATE THESE WITH YOUR DEPLOYED CONTRACTS
VITE_TOKEN_FACTORY_CONTRACT=0x0000000000000000000000000000000000000000
VITE_NFT_FACTORY_CONTRACT=0x0000000000000000000000000000000000000000
VITE_PAYMENT_CONTRACT=0x0000000000000000000000000000000000000000

# opBNB Mainnet Configuration
VITE_OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
VITE_OPBNB_CHAIN_ID=204
VITE_OPBNB_EXPLORER=https://opbnbscan.com

# Lighthouse Storage Configuration (Decentralized IPFS Storage)
# Get your API key from: https://files.lighthouse.storage/
VITE_LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here
